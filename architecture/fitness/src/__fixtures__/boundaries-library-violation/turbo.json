{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {}
  },
  "boundaries": {
    "tags": {
      "landing": {
        "dependencies": {
          "allow": [
            "ui",
            "contracts"
          ],
          "deny": [
            "trading-app"
          ]
        }
      },
      "trading-app": {
        "dependencies": {
          "allow": [
            "ui",
            "contracts"
          ],
          "deny": [
            "landing"
          ]
        }
      },
      "ui": {
        "dependencies": {
          "deny": [
            "landing",
            "trading-app"
          ]
        }
      },
      "contracts": {
        "dependencies": {
          "deny": [
            "landing",
            "trading-app"
          ]
        }
      }
    }
  }
}
