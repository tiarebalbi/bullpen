{
  "name": "@bullpen/fitness-checks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:arch": "tsx src/cli.ts",
    "adl:emit": "tsx src/adl-emit-cli.ts",
    "commit-policy": "tsx src/commit-policy-cli.ts",
    "rules-snapshot": "tsx src/rules-snapshot-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "test:db:ci": "vitest run -c vitest.db.config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "@bullpen/contracts": "workspace:*",
    "pg": "8.23.1",
    "@bullpen/db-trading": "workspace:*",
    "@bullpen/db-market-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
