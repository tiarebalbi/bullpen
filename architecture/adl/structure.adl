DESCRIPTION Bullpen's apps and libraries, and what may depend on what
CATEGORY Structural
DEFINE SYSTEM Bullpen AS bullpen
  DEFINE COMPONENT Landing AS apps/landing
  DEFINE COMPONENT Trading App AS apps/web
  DEFINE COMPONENT Market Data Service AS apps/market-data
  DEFINE COMPONENT Sweeper AS apps/sweeper
  DEFINE LIBRARY UI AS packages/ui
  DEFINE LIBRARY Contracts AS packages/contracts
  DEFINE LIBRARY market-data AS packages/db-market-data
  DEFINE LIBRARY trading AS packages/db-trading

# Structural assertions
ASSERT(every directory under apps and packages is DEFINED)
ASSERT(every DEFINED COMPONENT and LIBRARY exists as a directory)

# Allowed dependencies
ASSERT(Landing IS DEPENDENT ON UI, Contracts)
ASSERT(Trading App IS DEPENDENT ON UI, Contracts, trading)
ASSERT(Market Data Service IS DEPENDENT ON Contracts, market-data)
ASSERT(Sweeper IS DEPENDENT ON Contracts)

# Disallowed dependencies (direct and transitive)
ASSERT(Landing HAS NO DEPENDENCY ON Trading App)
ASSERT(Trading App HAS NO DEPENDENCY ON Landing)
ASSERT(UI HAS NO DEPENDENCY ON Landing, Trading App)
ASSERT(Contracts HAS NO DEPENDENCY ON Landing, Trading App)
ASSERT(Market Data Service HAS NO DEPENDENCY ON Landing, Trading App, UI)
ASSERT(Landing HAS NO DEPENDENCY ON Market Data Service)
ASSERT(Trading App HAS NO DEPENDENCY ON Market Data Service)
ASSERT(UI HAS NO DEPENDENCY ON Market Data Service)
ASSERT(Contracts HAS NO DEPENDENCY ON Market Data Service)
ASSERT(Trading App HAS NO DEPENDENCY ON market-data)
ASSERT(Market Data Service HAS NO DEPENDENCY ON trading)
ASSERT(trading HAS NO DEPENDENCY ON market-data)
ASSERT(market-data HAS NO DEPENDENCY ON trading)
ASSERT(Landing HAS NO DEPENDENCY ON trading, market-data)
ASSERT(Sweeper HAS NO DEPENDENCY ON Landing, Trading App, Market Data Service, UI, trading, market-data)
ASSERT(Landing HAS NO DEPENDENCY ON Sweeper)
ASSERT(Trading App HAS NO DEPENDENCY ON Sweeper)
ASSERT(Market Data Service HAS NO DEPENDENCY ON Sweeper)

# Entry points and secrets
ASSERT(COMPONENTS use LIBRARIES ONLY THROUGH their package entry point)
ASSERT(ONLY apps/market-data/src READS COINGECKO_DEMO_API_KEY)
ASSERT(ONLY apps/market-data/src READS ALPHA_VANTAGE_API_KEY)
ASSERT(ONLY apps/market-data/src READS CRON_SECRET)
ASSERT(ONLY apps/market-data/src/db READS DATABASE_URL_MARKET_DATA)
ASSERT(ONLY apps/web/app/lib/trading READS DATABASE_URL_TRADING)
ASSERT(ONLY apps/web/app/lib/trading READS SWEEP_SECRET)
ASSERT(ONLY apps/sweeper/src READS SWEEPER_TOKEN)
ASSERT(ONLY apps/web/app/lib/auth READS NEON_AUTH_BASE_URL)
ASSERT(ONLY apps/web/app/lib/auth READS NEON_AUTH_COOKIE_SECRET)

# Data ownership
ASSERT(ONLY market-data WRITES market_data)
ASSERT(trading READS market_data ONLY THROUGH market_data.prices_v1)
ASSERT(ONLY trading WRITES trading.orders AND trading.ledger)

# Model currency
ASSERT(every DEFINED COMPONENT and LIBRARY maps to a node in the current CALM moment)
ASSERT(every webclient and service node in the current CALM moment maps to a DEFINED entry)
