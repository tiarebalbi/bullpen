{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "market-data": {
      "root": "apps/market-data/",
      "functions": {
        "api/**/*.ts": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/price/(.*)",
      "destination": {
        "service": "market-data"
      }
    },
    {
      "source": "/api/cron/(.*)",
      "destination": {
        "service": "market-data"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
