{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "nextjs"
    },
    "market-data": {
      "root": "apps/market-data/",
      "runtime": "node",
      "entrypoint": "server.ts",
      "functions": {
        "server.ts": {
          "maxDuration": 300
        }
      }
    }
  },
  "daemons": {
    "sweeper": {
      "root": "apps/sweeper/",
      "entrypoint": "Dockerfile",
      "instances": { "iad1": 1 }
    }
  },
  "rewrites": [
    {
      "source": "/api/price/(.*)",
      "destination": {
        "service": "market-data"
      }
    },
    {
      "source": "/api/cron/(.*)",
      "destination": {
        "service": "market-data"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 23 * * *"
    }
  ]
}
