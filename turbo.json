{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".generated/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build", "^build"]
    },
    "check:arch": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "landing": {
        "dependencies": { "allow": ["ui", "contracts"], "deny": ["trading-app"] }
      },
      "trading-app": {
        "dependencies": { "allow": ["ui", "contracts"], "deny": ["landing"] }
      },
      "ui": {
        "dependencies": { "deny": ["landing", "trading-app"] }
      },
      "contracts": {
        "dependencies": { "deny": ["landing", "trading-app"] }
      }
    }
  }
}
